PORT=5000

# MongoDB Atlas / local MongoDB. Leave blank for demo-memory mode.
DB_URL=

# Set false only when you have configured real integrations.
DEMO_MODE=true

# Razorpay Test Mode (never commit the secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional receipt email via Resend HTTP API
RESEND_API_KEY=
MAIL_FROM=YourTube Lab <onboarding@resend.dev>
SUPPORT_EMAIL=support@example.com

# Optional comma-separated moderation words
BLOCKED_WORDS=idiot,stupid,abuseword

# Public frontend origin used by your deployment documentation
FRONTEND_URL=http://localhost:3000
